SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
SUPABASE_SECRET_KEY=replace-with-server-only-secret-key
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

AI_PROVIDER=deterministic
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
HUGGINGFACE_TOKEN=
HUGGINGFACE_MODEL=

# SMTP credentials stay on the backend. For Microsoft 365, SMTP_HOST is
# commonly smtp.office365.com; for Gmail it is smtp.gmail.com with an app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=CrisisWatch
SMTP_USE_TLS=true
PUBLIC_APP_URL=http://127.0.0.1:5173
EMAIL_SCHEDULER_POLL_SECONDS=30

# Optional Pinecone RAG for approved response playbooks. Keep disabled until
# the index has been created and populated with: python -m app.index_playbooks
PINECONE_RAG_ENABLED=false
PINECONE_API_KEY=
PINECONE_INDEX_NAME=crisiswatch-playbooks
PINECONE_INDEX_HOST=
PINECONE_NAMESPACE=approved-playbooks
PINECONE_EMBEDDING_MODEL=llama-text-embed-v2
PINECONE_TOP_K=5
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
